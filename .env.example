# -----------------------------------------------------------------------------
# Documents every environment variable used by the project.
# Real values live in .env.dev and .env.test (dummy values, local use only).
# Never put production secrets in any committed file.
# -----------------------------------------------------------------------------

# --- booking-api ---------------------------------------------------------------
# dev | test. Test-only endpoints (/test/reset, /test/seed) and the X-Test-Now
# header work ONLY when APP_ENV=test.
APP_ENV=dev
# Port the API listens on (inside Docker it is always 3000).
PORT=3000
# Secret used to sign JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (jsonwebtoken format: 15m, 1h, 900).
JWT_EXPIRES_IN=15m
# bcrypt cost factor. Lower = faster tests, higher = more secure.
BCRYPT_ROUNDS=10
# Hour (UTC) at which a stay starts. Used for the 48h free-cancellation rule.
CHECKIN_HOUR_UTC=14
# Allowed browser origins for CORS (comma separated). Empty = CORS off.
CORS_ORIGIN=http://localhost:5173
# Where booking-api finds payment-service (inside Docker: the service name).
PAYMENT_SERVICE_URL=http://payment-service:4000
# How long booking-api waits for payment-service before giving up (→ 504).
PAYMENT_TIMEOUT_MS=3000

# --- payment-service -----------------------------------------------------------
# How long the tok_slow card token waits before answering.
PAYMENT_SLOW_MS=5000

# --- database ------------------------------------------------------------------
# Used by the postgres container AND by booking-api to build its DATABASE_URL.
# (Alternatively set DATABASE_URL directly.)
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hotel
# Where booking-api finds Postgres when it runs OUTSIDE Docker
# (docker-compose overrides these to postgres:5432).
DB_HOST=localhost
DB_PORT=5432

# --- seed data (POST /test/seed) -------------------------------------------------
SEED_ADMIN_EMAIL=admin@hotel.test
SEED_ADMIN_PASSWORD=change-me
SEED_GUEST1_EMAIL=guest1@hotel.test
SEED_GUEST1_PASSWORD=change-me
SEED_GUEST2_EMAIL=guest2@hotel.test
SEED_GUEST2_PASSWORD=change-me

# --- test suites -------------------------------------------------------------------
# URLs the API / E2E test suites call.
BASE_URL=http://localhost:3000
PAYMENT_URL=http://localhost:4000
# URL the E2E tests open in the browser (the frontend container).
FRONTEND_URL=http://localhost:5173
