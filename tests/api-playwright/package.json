{
  "name": "api-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "API test suite for the hotel booking system (Playwright Test, TypeScript)",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "20.17.10",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "dotenv": "16.4.5",
    "typescript": "5.7.2"
  }
}
