{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quote",
  "description": "GET /rooms/{id}/quote (200): price of a stay, night by night. Nightly prices are unrounded; totalPrice is rounded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["roomId", "checkIn", "checkOut", "pricePerNight", "nights", "totalPrice"],
  "properties": {
    "roomId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "checkIn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "checkOut": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pricePerNight": { "type": "number", "exclusiveMinimum": 0 },
    "nights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "isWeekend", "price"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "isWeekend": { "type": "boolean" },
          "price": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "totalPrice": { "type": "number", "exclusiveMinimum": 0 }
  }
}
