{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Booking",
  "description": "POST /bookings (201), GET /bookings/{id}, POST /bookings/{id}/cancel.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "roomId", "userId", "checkIn", "checkOut", "guests", "totalPrice", "status", "paymentId", "createdAt", "cancelledAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "roomId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "userId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "checkIn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "checkOut": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "guests": { "type": "integer", "minimum": 1, "maximum": 6 },
    "totalPrice": { "type": "number", "exclusiveMinimum": 0 },
    "status": { "type": "string", "enum": ["PENDING_PAYMENT", "CONFIRMED", "PAYMENT_FAILED", "CANCELLED"] },
    "paymentId": { "type": ["string", "null"], "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "cancelledAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
