{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoginResponse",
  "description": "POST /auth/login (200).",
  "type": "object",
  "additionalProperties": false,
  "required": ["accessToken", "tokenType", "expiresIn", "user"],
  "properties": {
    "accessToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
    "tokenType": { "type": "string", "enum": ["Bearer"] },
    "expiresIn": { "type": "integer", "minimum": 1 },
    "user": { "$ref": "#/definitions/User" }
  },
  "definitions": {
    "User": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email", "fullName", "role", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "email": { "type": "string", "pattern": "^[^@\\sA-Z]+@[^@\\sA-Z]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["GUEST", "ADMIN"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
