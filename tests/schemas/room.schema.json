{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room",
  "description": "GET /rooms/{id}, POST /rooms (201), PUT /rooms/{id}, PATCH /rooms/{id}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "number", "type", "capacity", "pricePerNight", "isActive"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "number": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,10}$" },
    "type": { "type": "string", "enum": ["SINGLE", "DOUBLE", "SUITE"] },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 6 },
    "pricePerNight": { "type": "number", "exclusiveMinimum": 0 },
    "isActive": { "type": "boolean" }
  }
}
