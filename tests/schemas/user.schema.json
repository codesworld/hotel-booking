{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "description": "POST /auth/register (201) and GET /auth/me (200). additionalProperties=false guarantees no password data leaks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "email", "fullName", "role", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "email": { "type": "string", "pattern": "^[^@\\sA-Z]+@[^@\\sA-Z]+$" },
    "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "role": { "type": "string", "enum": ["GUEST", "ADMIN"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
