# Serves the built React app and forwards /api/* to booking-api.
# ${BOOKING_API_URL} is filled in from the environment when the container starts
# (official nginx image: files in /etc/nginx/templates are run through envsubst).
server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;

    # /api/rooms → ${BOOKING_API_URL}/rooms
    location /api/ {
        proxy_pass ${BOOKING_API_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location = /health {
        access_log off;
        return 200 'ok';
    }

    # Single-page app: unknown paths (e.g. /bookings) load index.html; React Router takes over.
    location / {
        try_files $uri /index.html;
    }
}
